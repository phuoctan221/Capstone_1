# FastAPI backend
APP_NAME="SmartVOCAB AI"
APP_VERSION="1.0.0"
DEBUG=true

# MongoDB
MONGO_URI=""
MONGO_DB_NAME="capstone1"

# Authentication
JWT_SECRET="change-me-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini AI
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# CORS
CORS_ORIGINS='["http://localhost:5173","http://localhost:5174"]'

# Mastery
MASTERY_THRESHOLD=80
MASTERY_CORRECT_GAIN=10
MASTERY_WRONG_PENALTY=5
MASTERY_HINT_FACTOR=0.5
MASTERY_FAST_BONUS=2
MASTERY_FAST_MS=4000

# Exercise
MIN_LESSON_WORDS=4
SESSION_MAX_QUESTIONS=20

# Cloudflare Workers AI
CF_ACCOUNT_ID=""
CF_API_TOKEN=""
CF_MODEL="@cf/meta/llama-3.1-8b-instruct"
CF_RPM=30