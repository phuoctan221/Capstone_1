# ===== SmartVOCAB AI - cau hinh backend =====
# Copy file nay thanh ".env" roi dien thong tin that:
#   Windows      : copy .env.example .env
#   macOS/Linux  : cp .env.example .env
#
# File ".env" duoc .gitignore nen KHONG commit len git.
# Moi thanh vien deu co the copy file mau nay va dung chung mot cluster Atlas.

APP_NAME="SmartVOCAB AI"
APP_VERSION="1.0.0"
DEBUG=true

# ===== MongoDB Atlas (dung chung cho ca team) =====
# Lay connection string tai Atlas UI > Database Access > "Connect" > Drivers.
# Hay chay lenh sau de sinh connection string day du:
#   mongosh "mongodb+srv://<user>:<password>@<cluster>.mongodb.net" \
#     --eval "db.getSiblingDB('capstone1').getMongo().getURI()"
MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/capstone1?authSource=admin"
MONGO_DB_NAME="capstone1"

# Timeout chon server (ms). Tang len neu mang cham.
MONGO_TIMEOUT_MS=15000

# ===== Auth =====
# Sinh chuoi ngau nhien moi nguoi: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="generate-a-random-secret-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== Gemini AI =====
# API key rieng cho tung thanh vien (goi quota). Lay tai https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-flash-latest"

# ===== CORS =====
CORS_ORIGINS='["http://localhost:5173"]'
