# FastAPI backend
APP_NAME="SmartVOCAB AI"
APP_VERSION="1.0.0"
DEBUG=true

# MongoDB
MONGO_URI=""
MONGO_DB_NAME="capstone1"

# Authentication
JWT_SECRET="change-me-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini AI
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# AI Story
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"

# CORS
CORS_ORIGINS='["http://localhost:5173","http://localhost:5174"]'

# Mastery
MASTERY_THRESHOLD=80
MASTERY_CORRECT_GAIN=10
MASTERY_WRONG_PENALTY=5
MASTERY_HINT_FACTOR=0.5
MASTERY_FAST_BONUS=2
MASTERY_FAST_MS=4000

# Exercise
MIN_LESSON_WORDS=4
SESSION_MAX_QUESTIONS=20

# Level Assessment
ASSESSMENT_QUESTION_COUNT=15
ASSESSMENT_PASS_PERCENT=70
ASSESSMENT_EXPIRE_MINUTES=30
ASSESSMENT_RETRY_COOLDOWN_MINUTES=5

# Gmail SMTP password-reset delivery. Create a Gmail App Password (not your
# normal Gmail password), then put it in backend/.env only; never commit it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME="your-gmail-address@gmail.com"
SMTP_APP_PASSWORD="your-16-character-gmail-app-password"
SMTP_FROM_EMAIL="your-gmail-address@gmail.com"
SMTP_FROM_NAME="SmartVOCAB AI"
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_SEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_SENDS_PER_HOUR=5

# Cloudflare Workers AI
CF_ACCOUNT_ID=""
CF_API_TOKEN=""
CF_MODEL="@cf/meta/llama-3.1-8b-instruct"
CF_RPM=30
# Pronunciation practice
SPEECHACE_API_KEY=
SPEECHACE_URL=https://api.speechace.co/api/scoring/text/v9/json
SPEECHACE_DIALECT=en-us
PRONUNCIATION_PROVIDER=speechace
CHIVOX_API_KEY=
FFMPEG_PATH=ffmpeg
