# SmartVOCAB AI - Docker Compose environment reference
#
# This file is only documentation. Docker Compose reads backend/.env
# (see docker-compose.yml -> env_file). Never commit real secrets.
#
#   copy .env.docker.example backend/.env
#   (Windows) copy .env.docker.example backend\.env
#
# PHASE A (current): keep the shared MongoDB Atlas cluster.
# PHASE B (future): point MONGO_URI at the local 3-node replica set.
#
# --- App ---
APP_NAME="SmartVOCAB AI"
APP_VERSION="1.0.0"
DEBUG=false

# --- MongoDB Atlas (Phase A) ---
MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/capstone1?authSource=admin&retryWrites=true&w=majority"
MONGO_DB_NAME="capstone1"
MONGO_TIMEOUT_MS=10000

# --- MongoDB replica set (Phase B, not used yet) ---
# MONGO_URI="mongodb://mongo1:27017,mongo2:27017,mongo3:27017/capstone1?replicaSet=rs0&retryWrites=true&w=majority"

# --- Auth ---
JWT_SECRET="<generate-a-random-secret>"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Gemini AI ---
GEMINI_API_KEY="<your-gemini-api-key>"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_RPM=10

# --- Optional AI / feature keys ---
# Story game (Mistral) and Cloudflare fallback for ai_service.
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"
CF_ACCOUNT_ID=""
CF_API_TOKEN=""
CF_MODEL="@cf/meta/llama-3.1-8b-instruct"
CF_RPM=30
DICTIONARY_RPM=30

# Speaking practice (choose one provider).
SPEECHACE_API_KEY=""
SPEECHACE_URL="https://api.speechace.co/api/scoring/text/v9/json"
SPEECHACE_DIALECT="en-us"
PRONUNCIATION_PROVIDER="speechace"
CHIVOX_API_KEY=""
FFMPEG_PATH="ffmpeg"
AVATAR_MAX_BYTES=2097152

# Assessment, exercise engine and Mastery defaults.
ASSESSMENT_QUESTION_COUNT=15
ASSESSMENT_PASS_PERCENT=70
ASSESSMENT_EXPIRE_MINUTES=30
ASSESSMENT_RETRY_COOLDOWN_MINUTES=5
SESSION_MAX_QUESTIONS=20
MIN_LESSON_WORDS=4
MASTERY_THRESHOLD=80
MASTERY_CORRECT_GAIN=10
MASTERY_WRONG_PENALTY=5
MASTERY_HINT_FACTOR=0.5
MASTERY_FAST_BONUS=2
MASTERY_FAST_MS=4000

# Password reset via SMTP. Use a Gmail App Password, never the normal password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_APP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="SmartVOCAB AI"
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_SEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_SENDS_PER_HOUR=5

# --- CORS ---
# Browser talks to nginx on the same origin, so CORS is mostly a no-op
# in Docker. Add origins only if you call the API directly.
CORS_ORIGINS='["http://localhost:8080"]'
