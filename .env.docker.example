# SmartVOCAB AI - Docker Compose environment reference
#
# This file is only documentation. Docker Compose reads backend/.env
# (see docker-compose.yml -> env_file). Never commit real secrets.
#
#   copy .env.docker.example backend/.env
#   (Windows) copy .env.docker.example backend\.env
#
# PHASE A (current): keep the shared MongoDB Atlas cluster.
# PHASE B (future): point MONGO_URI at the local 3-node replica set.
#
# --- App ---
APP_NAME="SmartVOCAB AI"
APP_VERSION="1.0.0"
DEBUG=false

# --- MongoDB Atlas (Phase A) ---
MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/capstone1?authSource=admin&retryWrites=true&w=majority"
MONGO_DB_NAME="capstone1"
MONGO_TIMEOUT_MS=15000

# --- MongoDB replica set (Phase B, not used yet) ---
# MONGO_URI="mongodb://mongo1:27017,mongo2:27017,mongo3:27017/capstone1?replicaSet=rs0&retryWrites=true&w=majority"

# --- Auth ---
JWT_SECRET="<generate-a-random-secret>"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Gemini AI ---
GEMINI_API_KEY="<your-gemini-api-key>"
GEMINI_MODEL="gemini-flash-latest"

# --- CORS ---
# Browser talks to nginx on the same origin, so CORS is mostly a no-op
# in Docker. Add origins only if you call the API directly.
CORS_ORIGINS='["http://localhost:8080"]'
